<resources>

    <!-- Theme sáng cố định, thanh tiêu đề màu teal -->
    <style name="Theme.QuanLyDanhBa" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryVariant">@color/teal_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="colorSecondaryVariant">@color/teal_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="materialButtonStyle">@style/Widget.QuanLyDanhBa.Button</item>
    </style>

    <!-- Màn hình đăng nhập không cần thanh tiêu đề -->
    <style name="Theme.QuanLyDanhBa.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Nút bo tròn mặc định (MaterialButton dùng cornerRadius thay cho drawable nền) -->
    <style name="Widget.QuanLyDanhBa.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Nút viền teal (Quay lại) -->
    <style name="Widget.QuanLyDanhBa.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/teal</item>
        <item name="strokeColor">@color/teal</item>
        <item name="strokeWidth">@dimen/button_stroke_width</item>
    </style>

    <!-- Nút đỏ (Xóa) -->
    <style name="Widget.QuanLyDanhBa.Button.Danger">
        <item name="backgroundTint">@color/red</item>
    </style>

    <!-- Nhãn phía trên ô nhập -->
    <style name="TextAppearance.QuanLyDanhBa.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Ô nhập liệu bo góc -->
    <style name="Widget.QuanLyDanhBa.EditText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">@dimen/input_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/input_padding_horizontal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>
